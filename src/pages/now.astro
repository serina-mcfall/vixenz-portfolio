    margin-bottom: 0.75rem;
  }

  .opener h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .lede {
    font-size: var(--text-lede);
    color: var(--mist);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 36rem;
  }

  .now section {
    margin-bottom: 2.5rem;
  }

  .now h2 {
    font-size: var(--text-h3);
    margin-bottom: 0.75rem;
    color: var(--lantern);
  }

  .updated {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
